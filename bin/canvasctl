#!/usr/bin/env node
'use strict';
// canvasctl — the cnvsctl-style control CLI for agent-canvas.
// Used by the orchestrator (Forest) to spawn/inspect worker agents.

const SERVER = process.env.CANVAS_SERVER || 'http://127.0.0.1:4923';

function parseFlags(argv) {
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    if (argv[i].startsWith('--')) { flags[argv[i].slice(2)] = argv[i + 1]; i++; }
  }
  return flags;
}

async function api(method, pathName, body) {
  const res = await fetch(SERVER + pathName, {
    method,
    headers: { 'Content-Type': 'application/json' },
    body: body ? JSON.stringify(body) : undefined,
  });
  const text = await res.text();
  if (!res.ok) throw new Error(`${res.status}: ${text}`);
  return text;
}

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  if (cmd === 'spawn') {
    const f = parseFlags(rest);
    if (!f.name || !f.focus) throw new Error('usage: canvasctl spawn --name <Name> --focus <area> [--target <dir>] [--model <m>]');
    const out = await api('POST', '/api/spawn', {
      name: f.name, focus: f.focus, target: f.target || process.env.CANVAS_TARGET, model: f.model,
    });
    console.log(`spawned ${f.name} (focus: ${f.focus}) → ${JSON.parse(out).report}`);
  } else if (cmd === 'status') {
    const out = JSON.parse(await api('GET', '/api/panes'));
    for (const p of out) console.log(`${p.name}\t${p.role}\t${p.status}\t${p.focus || ''}\t${p.report || ''}`);
    if (!out.length) console.log('(no panes)');
  } else if (cmd === 'report') {
    if (!rest[0]) throw new Error('usage: canvasctl report <Name>');
    console.log(await api('GET', `/api/report/${encodeURIComponent(rest[0])}`));
  } else {
    console.log(`canvasctl — agent canvas control
commands:
  spawn --name <Name> --focus <area> [--target <dir>] [--model <m>]   spawn a worker agent pane
  status                                                              list panes and states
  report <Name>                                                       print a worker's report`);
    process.exitCode = cmd ? 1 : 0;
  }
}

main().catch((e) => { console.error(String(e.message || e)); process.exit(1); });
